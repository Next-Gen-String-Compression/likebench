# ---- Benchmark data & outputs (regenerated, large) ----
/data/cache/
/data/**/*.parquet
/data/**/*.vortex
/data/**/*.csv
/data/**/*.csv.gz
/data/**/*.json.gz

# Results are regenerated by `python run.py`. We keep the directory shape
# (via .gitkeep) but ignore the heavy/auto-generated artifacts.
/results/results.json
/results/table.md
/results/table.csv
/results/metadata.json
/results/plots/*.png
/results/plots/*.svg

